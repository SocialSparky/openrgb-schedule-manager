#!/usr/bin/env bash

CONF="$HOME/.config/openrgb_schedule.conf"
STATE="/tmp/openrgb_current_profile_${USER}"
mkdir -p "$HOME/.config"

find_orp_files() {
    find "$HOME/.config/OpenRGB" "$HOME/.var/app/org.openrgb.OpenRGB/config/OpenRGB" \
        -maxdepth 1 -name "*.orp" -printf "%f\n" 2>/dev/null | sed 's/\.orp$//' | sort -u
}

run_openrgb() {
    if command -v openrgb >/dev/null 2>&1; then
        openrgb --noautoconnect --profile "$1" >/dev/null 2>&1
    elif flatpak info org.openrgb.OpenRGB >/dev/null 2>&1; then
        flatpak run org.openrgb.OpenRGB --noautoconnect --profile "$1" >/dev/null 2>&1
    fi
}

# 1. Initialize or Auto-Upgrade Config
if [[ ! -f "$CONF" ]]; then
    FIRST_PROF=$(find_orp_files | head -n 1)
    [[ -z "$FIRST_PROF" ]] && FIRST_PROF="Default"
    cat << INIT > "$CONF"
Everyday|08:00|$FIRST_PROF
Everyday|21:00|$FIRST_PROF
INIT
fi

# Auto-upgrade old configs missing the "Days" column
sed -i -E 's/^([0-9]{2}:[0-9]{2})\|(.*)$/Everyday|\1|\2/' "$CONF"

sort_conf() {
    grep -v '^[[:space:]]*$' "$CONF" | sort -t'|' -k2,2 > "${CONF}.tmp" && mv "${CONF}.tmp" "$CONF"
}
sort_conf

get_profiles() {
    local current_first="$1"
    local list=()
    [[ -n "$current_first" ]] && list+=("$current_first")

    while IFS= read -r prof; do
        [[ -n "$prof" && "$prof" != "$current_first" ]] && list+=("$prof")
    done < <(find_orp_files)

    [[ ${#list[@]} -eq 0 ]] && list=("Default")
    
    local IFS='|'
    echo "${list[*]}"
}

# 2. Interactive GUI Manager
if [[ "$1" == "--gui" ]]; then
    while true; do
        MENU_ITEMS=()
        while IFS='|' read -r d t p; do
            [[ -z "$d" ]] && continue
            MENU_ITEMS+=("${d} @ ${t}" "$p")
        done < "$CONF"

        CHOICE=$(zenity --list \
            --title="OpenRGB Schedule Manager" \
            --text="💡 Tip: Double-click a time slot to Edit/Delete, or an action below to run it." \
            --width=550 --height=450 \
            --column="Schedule (Day @ Time)" --column="OpenRGB Profile" \
            "${MENU_ITEMS[@]}" \
            "=========================" "===" \
            "➕ Add New Slot" "Create a new rule" \
            "✅ Save & Apply Now" "Apply and exit")

        if [[ -z "$CHOICE" || "$CHOICE" == "✅ Save & Apply Now" ]]; then
            rm -f "$STATE"
            break
        elif [[ "$CHOICE" == *"==="* || "$CHOICE" == *"==="* ]]; then
            continue
        elif [[ "$CHOICE" == "➕ Add New Slot" ]]; then
            PROF_LIST=$(get_profiles "")
            DAY_LIST="Everyday|Weekdays (Mon-Fri)|Weekends (Sat-Sun)|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday"
            
            NEW_ENTRY=$(zenity --forms --title="Add Time Slot" \
                --text="Set the days, time, and profile:" \
                --add-combo="Active Days:" --combo-values="$DAY_LIST" \
                --add-entry="Start Time (HH:MM):" \
                --add-combo="Select Profile:" --combo-values="$PROF_LIST")

            if [[ -n "$NEW_ENTRY" ]]; then
                ND=$(echo "$NEW_ENTRY" | cut -d'|' -f1)
                NT=$(echo "$NEW_ENTRY" | cut -d'|' -f2 | tr -d ' ')
                NP=$(echo "$NEW_ENTRY" | cut -d'|' -f3 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
                
                if [[ "$NT" =~ ^([01]?[0-9]|2[0-3]):[0-5][0-9]$ && -n "$NP" && -n "$ND" ]]; then
                    [[ ${#NT} -eq 4 ]] && NT="0$NT"
                    grep -v "^${ND}|${NT}|" "$CONF" > "${CONF}.tmp" && mv "${CONF}.tmp" "$CONF"
                    echo "${ND}|${NT}|${NP}" >> "$CONF"
                    sort_conf
                else
                    zenity --error --text="Invalid format! Check your inputs."
                fi
            fi
        elif [[ -n "$CHOICE" ]]; then
            # Parse the combined "Day @ Time" string back into variables
            CUR_DAY=$(echo "$CHOICE" | awk -F' @ ' '{print $1}')
            CUR_TIME=$(echo "$CHOICE" | awk -F' @ ' '{print $2}')
            CUR_PROF=$(grep "^${CUR_DAY}|${CUR_TIME}|" "$CONF" | head -n1 | cut -d'|' -f3)

            ACTION=$(zenity --question --title="Manage Slot" \
                --text="Selected: $CUR_DAY at $CUR_TIME -> $CUR_PROF\n\nWhat would you like to do?" \
                --ok-label="Edit Slot" \
                --cancel-label="Cancel" \
                --extra-button="Delete Slot")

            RET=$?
            if [[ "$ACTION" == "Delete Slot" ]]; then
                grep -v "^${CUR_DAY}|${CUR_TIME}|" "$CONF" > "${CONF}.tmp" && mv "${CONF}.tmp" "$CONF"
            elif [[ $RET -eq 0 ]]; then
                PROF_LIST=$(get_profiles "$CUR_PROF")
                DAY_LIST="$CUR_DAY|Everyday|Weekdays (Mon-Fri)|Weekends (Sat-Sun)|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday"

                EDIT_ENTRY=$(zenity --forms --title="Edit Slot" \
                    --text="Update settings (leave time blank to keep $CUR_TIME):" \
                    --add-combo="Active Days:" --combo-values="$DAY_LIST" \
                    --add-entry="Start Time (Current: $CUR_TIME):" \
                    --add-combo="Select Profile:" --combo-values="$PROF_LIST")

                if [[ -n "$EDIT_ENTRY" ]]; then
                    ND=$(echo "$EDIT_ENTRY" | cut -d'|' -f1)
                    NT=$(echo "$EDIT_ENTRY" | cut -d'|' -f2 | tr -d ' ')
                    NP=$(echo "$EDIT_ENTRY" | cut -d'|' -f3 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
                    
                    [[ -z "$NT" ]] && NT="$CUR_TIME"
                    
                    if [[ "$NT" =~ ^([01]?[0-9]|2[0-3]):[0-5][0-9]$ ]]; then
                        [[ ${#NT} -eq 4 ]] && NT="0$NT"
                        grep -v "^${CUR_DAY}|${CUR_TIME}|" "$CONF" > "${CONF}.tmp" && mv "${CONF}.tmp" "$CONF"
                        echo "${ND}|${NT}|${NP}" >> "$CONF"
                        sort_conf
                    else
                        zenity --error --text="Invalid time format!"
                    fi
                fi
            fi
        fi
    done
fi

# 3. Weekly Time Evaluation Logic (Converts everything to absolute minute of the week)
DAY_IDX=$(( $(date +%u) - 1 )) # 0=Mon, 6=Sun

if [[ -n "$1" && "$1" != "--gui" ]]; then
    NOW_H=${1:0:2}
    NOW_M=${1:2:2}
else
    NOW_H=$(date +%H)
    NOW_M=$(date +%M)
fi
CUR_MIN=$(( DAY_IDX * 1440 + 10#$NOW_H * 60 + 10#$NOW_M ))

> /tmp/openrgb_week.tmp
while IFS='|' read -r days t p; do
    mins=$(( 10#${t%:*} * 60 + 10#${t#*:} ))
    
    # Map the dropdown choices to numerical days of the week (0=Mon, 6=Sun)
    case "$days" in
        "Everyday") d_list="0 1 2 3 4 5 6" ;;
        "Weekdays (Mon-Fri)") d_list="0 1 2 3 4" ;;
        "Weekends (Sat-Sun)") d_list="5 6" ;;
        "Monday") d_list="0" ;;
        "Tuesday") d_list="1" ;;
        "Wednesday") d_list="2" ;;
        "Thursday") d_list="3" ;;
        "Friday") d_list="4" ;;
        "Saturday") d_list="5" ;;
        "Sunday") d_list="6" ;;
        *) d_list="" ;;
    esac

    for d in $d_list; do
        echo "$(( d * 1440 + mins ))|$p" >> /tmp/openrgb_week.tmp
    done
done < "$CONF"

# Sort the weekly timeline chronologically
sort -n -t'|' -k1,1 /tmp/openrgb_week.tmp > /tmp/openrgb_week_sorted.tmp

# Find the active profile (defaults to the latest profile in the whole week for Sunday->Monday overnight wrapping)
PROFILE=$(tail -n 1 /tmp/openrgb_week_sorted.tmp | cut -d'|' -f2)

while IFS='|' read -r slot_min p; do
    if (( CUR_MIN >= slot_min )); then
        PROFILE="$p"
    fi
done < /tmp/openrgb_week_sorted.tmp

[[ -z "$PROFILE" ]] && exit 0

if [[ -n "$1" && "$1" != "--gui" ]]; then
    echo "Time evaluated: $1 -> Selected Profile: $PROFILE"
fi

LAST_PROFILE=$(cat "$STATE" 2>/dev/null)
[[ "$PROFILE" == "$LAST_PROFILE" ]] && exit 0

run_openrgb "$PROFILE"
echo "$PROFILE" > "$STATE"
